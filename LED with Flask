from flask import Flask, redirect, url_for
from gpiozero import LED

# Create the Flask app
app = Flask(__name__)

# Create the LED object on GPIO17
led = LED(17)

@app.route("/")
def home():
    # Simple web page with two buttons
    return """
    <h1>LED Control</h1>
    <p>GPIO17 on Raspberry Pi</p>
    <a href="/on"><button>Turn ON</button></a>
    <a href="/off"><button>Turn OFF</button></a>
    """

@app.route("/on")
def turn_on():
    led.on()
    return redirect(url_for("home"))

@app.route("/off")
def turn_off():
    led.off()
    return redirect(url_for("home"))

if __name__ == "__main__":
    # Listen on all interfaces so other devices can reach it
    app.run(host="0.0.0.0", port=5000)
